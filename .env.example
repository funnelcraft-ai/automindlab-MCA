# ===== Required (only these two) =====
DATABASE_URL=postgresql://user:pass@host:5432/railway
# 64 hex characters. Generate:  openssl rand -hex 32
# Encrypts every API key and calendar token at rest. Never change it after go-live (stored keys become unreadable).
APP_ENCRYPTION_KEY=

# ===== Everything else is entered in the dashboard (Integrations page) =====
# Optional: any of these, if set here, override the dashboard and show as "set in environment".
# PUBLIC_BASE_URL=https://calls.automindlab.io     (Railway's domain is detected automatically)
# SETUP_CODE=                                       (otherwise a random one-time code is printed in the logs)
# DATABASE_SSL=false
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_MESSAGING_SERVICE_SID=
# RETELL_API_KEY= / RETELL_VOICE_ID=retell-Cimo / RETELL_LLM_MODEL=gpt-4.1
# LLM_API_KEY= (Gemini key) / LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai / LLM_MODEL=gemini-3.8-flash
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
# SMTP_HOST= / SMTP_PORT=465 / SMTP_USER= / SMTP_PASS= / SMTP_FROM=
# SMS_MAX_AI_REPLIES_PER_DAY=15
# SHORT_CALL_SECONDS=15
# DRY_RUN=false        (true = simulate texts, calls, number purchases; for local testing only)
