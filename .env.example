# ---------- App ----------
PORT=3000
# Public HTTPS URL of this app (Railway domain or your own, e.g. https://calls.automindlab.io). No trailing slash.
PUBLIC_BASE_URL=https://calls.automindlab.io
AGENCY_NAME=Automindlab
# openssl rand -hex 32  (64 hex chars) - encrypts client Google tokens / Cal.com keys. Never change after go-live.
APP_ENCRYPTION_KEY=
# openssl rand -base64 48
JWT_SECRET=
# First admin login (created on first boot only)
ADMIN_EMAIL=hello@automindlab.io
ADMIN_PASSWORD=

# ---------- Database ----------
DATABASE_URL=postgresql://user:pass@host:5432/railway
DATABASE_SSL=false

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A2P 10DLC-registered Messaging Service (recommended). Per-client SIDs can be set in the dashboard.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VALIDATE_SIGNATURES=true

# ---------- Retell AI (voice) ----------
# Use the Retell API key that has the webhook badge (it signs webhooks + tool calls).
RETELL_API_KEY=
# Filled in after: npm run setup:retell
RETELL_LLM_ID=
RETELL_AGENT_ID=
RETELL_AGENT_VERSION=latest
RETELL_LLM_MODEL=gpt-4.1
RETELL_VOICE_ID=retell-Cimo
RETELL_VERIFY_SIGNATURES=true

# ---------- SMS AI (any OpenAI-compatible API) ----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
SMS_MAX_AI_REPLIES_PER_DAY=15

# ---------- Google Calendar booking (optional) ----------
# OAuth client (Web application). Authorized redirect URI: {PUBLIC_BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email alerts (optional; Zoho / Hostinger / any SMTP) ----------
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Automindlab Alerts <alerts@automindlab.io>

# ---------- Tuning ----------
SHORT_CALL_SECONDS=15
NO_EMAIL_DOMAIN=noemail.invalid
# true = log texts/emails/API calls instead of sending (local testing only)
DRY_RUN=false
